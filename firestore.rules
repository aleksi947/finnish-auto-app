rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. УРОКИ
    // Читать могут только авторизованные пользователи
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // 2. ПОЛЬЗОВАТЕЛИ
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Правила для прогресса пользователя (вложенная коллекция)
      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 3. ПОДПИСКИ (Критически важно!)
    match /subscriptions/{userId} {
      // Читать может только владелец подписки
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // ПИСАТЬ ЗАПРЕЩЕНО ВСЕМ С КЛИЕНТА
      // Изменять подписку может только сервер (Cloud Functions), который игнорирует эти правила
      allow write: if false;
    }
  }
}
