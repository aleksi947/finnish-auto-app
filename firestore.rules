rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. УРОКИ
    // Читать список уроков могут все (включая неавторизованных) - для страницы /lessons
    // Читать конкретный урок могут:
    // 1) Любой пользователь, если урок бесплатный (premium == false/null)
    // 2) Авторизованный пользователь с активной подпиской (active == true)
    // 3) Администратор (token.admin == true)
    match /lessons/{lessonId} {
      // Разрешаем чтение списка для всех (для страницы /lessons)
      // ВАЖНО: Неавторизованные увидят метаданные всех уроков, но не смогут открыть премиум
      allow list: if true;
      // Открытая бета: все уроки временно доступны бесплатно.
      // Поле premium и серверная логика подписки сохранены для будущего запуска.
      allow get: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // 2. ПОЛЬЗОВАТЕЛИ
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Правила для прогресса пользователя (вложенная коллекция)
      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 3. ПОДПИСКИ (Критически важно!)
    match /subscriptions/{userId} {
      // Читать может только владелец подписки
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // ПИСАТЬ ЗАПРЕЩЕНО ВСЕМ С КЛИЕНТА
      // Изменять подписку может только сервер (Cloud Functions), который игнорирует эти правила
      allow write: if false;
    }
  }
}
